#!/usr/bin/env sh
# Pre-commit: script tests → lint → unit tests → 70% coverage bar
# Same shape as ai-gantry scripts/pre-commit / pendant .husky/pre-commit.
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "==> Script tests"
make test-scripts

echo "==> Lint + unit tests + coverage"
make lint
make test-app
make coverage

echo "Pre-commit checks passed."
