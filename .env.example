# Copy to .env for a local sideload APK. Never commit .env.
# Precedence: process env > .env > local.properties > emulator defaults.
# CAB_GOOGLE_WEB_CLIENT_ID = pendant’s Web OAuth client (the token aud).
# Also create a separate Android OAuth client (package + SHA-1, no redirect).
CAB_MAILBOX_ORIGIN=http://10.0.2.2:3000
CAB_GOOGLE_WEB_CLIENT_ID=
